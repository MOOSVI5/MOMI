# Environment configuration for Momi
# Required for Momi AI Assistant (Gemini REST API via Secrets Gradle Plugin -> BuildConfig.GEMINI_API_KEY)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Public client configuration (AdMob, Start.io, Monetag, and Supabase public project URL + publishable key)
# is preconfigured via build.gradle.kts and Owner Monetization Console.
# NEVER place private server keys (such as Supabase service_role / sb_secret_ keys) in client builds.

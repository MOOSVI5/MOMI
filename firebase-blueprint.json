      "properties": {
        "userId": { "type": "string" },
        "ownerUsername": { "type": "string" },
        "storeName": { "type": "string" },
        "tagline": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "avatarKey": { "type": "string" },
        "avatarData": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "verifiedByEmail": { "type": "string" },
        "totalSales": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "ownerUsername", "storeName", "tagline", "category", "location", "avatarKey", "isVerified", "totalSales", "createdAt"]
    },
    "MarketProduct": {

      "required": ["admobEnabled", "admobBannerUnitId", "admobMrecUnitId", "admobInterstitialUnitId", "startIoEnabled", "monetagEnabled", "monetagDirectLinkUrl", "monetagWebZoneId", "monetagWebMetaTag", "partnerPromoTitle", "partnerPromoSubtitle", "partnerPromoCta", "updatedByEmail", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public creator profiles readable by signed-in Momi users, writable by owner."
    },
    "/users/{userId}/likedPosts/{postId}": {
      "schema": { "$ref": "#/entities/UserInteractionMarker" },
      "description": "Per-user liked post state."
    },
    "/users/{userId}/bookmarks/{postId}": {
      "schema": { "$ref": "#/entities/UserInteractionMarker" },
      "description": "Per-user saved/bookmarked post state."
    },
    "/users/{userId}/seenStories/{storyId}": {
      "schema": { "$ref": "#/entities/UserInteractionMarker" },
      "description": "Per-user seen story markers."
    },
    "/users/{userId}/likedComments/{commentId}": {
      "schema": { "$ref": "#/entities/UserInteractionMarker" },
      "description": "Per-user liked comment markers."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User's private inbox of notifications from cross-user activity."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Shared global Momi posts and Clips feed."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Shared comments on a Momi post."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "Shared Momi stories across creators."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/FollowEdge" },
      "description": "Directed follow relationships between Momi users."
    },
    "/threads/{threadId}": {
      "schema": { "$ref": "#/entities/MessageThread" },
      "description": "Shared 1:1 DM conversation threads."
    },
    "/threads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },

      "properties": {
        "sellerUid": { "type": "string" },
        "sellerUsername": { "type": "string" },
        "storeName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "priceUsd": { "type": "number" },
        "originalPriceUsd": { "type": "number" },
        "discountPercent": { "type": "integer" },
        "freeShipping": { "type": "boolean" },
        "imageKey": { "type": "string" },
        "imageData": { "type": "string" },
        "extraImageDatas": { "type": "array", "items": { "type": "string" } },
        "videoData": { "type": "string" },
        "videoChunksCount": { "type": "integer" },
        "videoDurationMs": { "type": "integer" },
        "stockCount": { "type": "integer" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["sellerUid", "sellerUsername", "storeName", "title", "description", "category", "priceUsd", "originalPriceUsd", "discountPercent", "freeShipping", "imageKey", "videoDurationMs", "stockCount", "createdAt"]
    },
    "MarketOrder": {
      "title": "MarketOrder",
      "description": "Private 1:1 marketplace order visible only to buyerUid and sellerUid.",
      "type": "object",
      "properties": {
        "buyerUid": { "type": "string" },
        "buyerUsername": { "type": "string" },
        "sellerUid": { "type": "string" },
        "sellerStoreName": { "type": "string" },
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "productImageKey": { "type": "string" },
        "productImageData": { "type": "string" },
        "priceUsd": { "type": "number" },
        "shippingAddress": { "type": "string" },
        "status": { "type": "string", "enum": ["PLACED", "SHIPPED", "DELIVERED"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["buyerUid", "buyerUsername", "sellerUid", "sellerStoreName", "productId", "productTitle", "productImageKey", "priceUsd", "shippingAddress", "status", "createdAt"]
    },
    "ContentReport": {
      "title": "ContentReport",
      "description": "User safety report for violent, sexual, graphic, harassment, or marketplace violations.",
      "type": "object",
      "properties": {
        "reporterUid": { "type": "string" },
        "reporterUsername": { "type": "string" },
        "targetType": { "type": "string", "enum": ["POST", "PRODUCT", "COMMENT", "USER"] },
        "targetId": { "type": "string" },
        "targetAuthorUid": { "type": "string" },
        "targetAuthorUsername": { "type": "string" },
        "targetPreviewText": { "type": "string" },
        "category": { "type": "string", "enum": ["VIOLENCE_GRAPHIC", "SEXUAL_NUDITY", "HARASSMENT_SPAM", "MARKETPLACE_SAFETY"] },
        "reasonDetail": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "REMOVED", "DISMISSED"] },
        "reviewedByUid": { "type": "string" },
        "reviewedByUsername": { "type": "string" },
        "reviewedByRole": { "type": "string", "enum": ["ADMIN", "MODERATOR", "EDITOR"] },
        "resolutionNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["reporterUid", "reporterUsername", "targetType", "targetId", "targetAuthorUsername", "targetPreviewText", "category", "reasonDetail", "status", "createdAt"]
    },
    "UserWallet": {
      "title": "UserWallet",
      "description": "Owner-private Momi account wallet storing spendable credits, gift earnings, and unlocked perk tiers.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "integer" },
        "totalEarned": { "type": "integer" },
        "totalSpent": { "type": "integer" },
        "totalPurchased": { "type": "integer" },
        "accountTier": { "type": "string", "enum": ["STANDARD", "SUPPORTER", "CREATOR_PRO", "VIP"] },
        "verificationTier": { "type": "string", "enum": ["NONE", "PENDING_PERK", "CREATOR_PRO", "VERIFIED"] },
        "unlockedPerks": { "type": "array", "items": { "type": "string" } },
        "lastTxId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "balance", "totalEarned", "totalSpent", "totalPurchased", "accountTier", "verificationTier", "unlockedPerks", "createdAt"]
    },
    "CreditTransaction": {
      "title": "CreditTransaction",
      "description": "Immutable credit ledger record for Google Play top-ups, live streamer/creator gifts, and perk unlocks.",
      "type": "object",
      "properties": {
        "txId": { "type": "string" },
        "type": { "type": "string", "enum": ["TOP_UP", "GIFT", "PERK_UNLOCK", "POST_BOOST", "OWNER_GRANT"] },
        "senderUid": { "type": "string" },
        "senderUsername": { "type": "string" },
        "recipientUid": { "type": "string" },
        "recipientUsername": { "type": "string" },
        "creditsAmount": { "type": "integer" },
        "priceUsd": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["GOOGLE_PLAY", "DEBUG_SANDBOX", "WALLET_CREDITS", "OWNER_ADMIN"] },
        "paymentRef": { "type": "string" },
        "giftKey": { "type": "string" },
        "giftName": { "type": "string" },
        "streamId": { "type": "string" },
        "perkKey": { "type": "string" },
        "postId": { "type": "string" },
        "recipientClaimed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["COMPLETED", "PENDING"] },

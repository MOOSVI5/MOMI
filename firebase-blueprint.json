{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public Momi creator profile (strictly no PII such as email or phone).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "category": { "type": "string" },
        "bio": { "type": "string" },
        "website": { "type": "string" },
        "avatarKey": { "type": "string" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "isVerified": { "type": "boolean" },
        "role": { "type": "string", "enum": ["USER", "MODERATOR", "EDITOR"] },
        "moderationScopes": { "type": "array", "items": { "type": "string" } },
        "assignedByEmail": { "type": "string" },
        "partnerConsent": { "type": "boolean" },
        "consentUpdatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "username", "displayName", "avatarKey", "followersCount", "followingCount", "isVerified", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Shared Photo or Clip post in the global Momi feed.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorDisplayName": { "type": "string" },
        "authorAvatarKey": { "type": "string" },
        "authorVerified": { "type": "boolean" },
        "location": { "type": "string" },
        "imageKey": { "type": "string" },
        "localImagePath": { "type": "string" },
        "imageData": { "type": "string", "description": "Compressed Base64 JPEG payload for cross-device photo sync." },
        "localExtraImagePaths": { "type": "array", "items": { "type": "string" } },
        "extraImageDatas": { "type": "array", "items": { "type": "string" } },
        "mediaType": { "type": "string", "enum": ["IMAGE", "VIDEO"] },
        "localVideoPath": { "type": "string" },
        "videoData": { "type": "string" },
        "videoChunksCount": { "type": "integer" },
        "videoDurationMs": { "type": "integer" },
        "filterTag": { "type": "string", "enum": ["NONE", "BLUE", "MAROON", "MONO", "WARM", "VINTAGE", "VIVID", "NOIR", "CINEMA", "PASTEL"] },
        "aspectRatio": { "type": "string", "enum": ["1:1", "4:5", "16:9"] },
        "taggedUsernames": { "type": "array", "items": { "type": "string" } },
        "hashtags": { "type": "array", "items": { "type": "string" } },
        "caption": { "type": "string" },
        "likesCount": { "type": "integer" },
        "viewsCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "category": { "type": "string" },
        "isReel": { "type": "boolean" },
        "audioTitle": { "type": "string" },
        "localAudioPath": { "type": "string" },
        "audioData": { "type": "string" },
        "isBoosted": { "type": "boolean" },
        "boostTier": { "type": "string", "enum": ["", "SPOTLIGHT", "SUPER_BOOST", "OWNER_RECOMMENDED"] },
        "recommendedLabel": { "type": "string" },
        "boostedByUid": { "type": "string" },
        "boostedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "authorUsername", "authorDisplayName", "authorAvatarKey", "authorVerified", "imageKey", "filterTag", "caption", "likesCount", "commentsCount", "category", "isReel", "createdAt"]
    },
    "VideoChunk": {
      "title": "VideoChunk",
      "description": "Ordered Base64 MP4 chunk slice enabling cross-device video playback up to ~8MB.",
      "type": "object",
      "properties": {
        "index": { "type": "integer" },
        "data": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["index", "data", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Shared comment on a Momi post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatarKey": { "type": "string" },
        "text": { "type": "string" },
        "likesCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "authorUsername", "authorAvatarKey", "text", "likesCount", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "Shared story frame in the Momi stories tray.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "avatarKey": { "type": "string" },
        "imageKey": { "type": "string" },
        "localImagePath": { "type": "string" },
        "imageData": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["IMAGE", "VIDEO"] },
        "localVideoPath": { "type": "string" },
        "videoData": { "type": "string" },
        "videoChunksCount": { "type": "integer" },
        "videoDurationMs": { "type": "integer" },
        "audioTitle": { "type": "string" },
        "localAudioPath": { "type": "string" },
        "audioData": { "type": "string" },
        "caption": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "username", "avatarKey", "imageKey", "caption", "createdAt"]
    },
    "FollowEdge": {
      "title": "FollowEdge",
      "description": "Directed follow relationship between followerUid and targetUid.",
      "type": "object",
      "properties": {
        "followerUid": { "type": "string" },
        "targetUid": { "type": "string" },
        "followerUsername": { "type": "string" },
        "targetUsername": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerUid", "targetUid", "followerUsername", "targetUsername", "createdAt"]
    },
    "UserInteractionMarker": {
      "title": "UserInteractionMarker",
      "description": "Per-user marker for liked posts, bookmarks, seen stories, or liked comments.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "createdAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Cross-user activity notification delivered to recipient userId.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorUsername": { "type": "string" },
        "actorAvatarKey": { "type": "string" },
        "message": { "type": "string" },
        "timeLabel": { "type": "string" },
        "section": { "type": "string" },
        "previewImageKey": { "type": "string" },
        "isFollowAction": { "type": "boolean" },
        "isFollowingBack": { "type": "boolean" },
        "isUnread": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "actorUid", "actorUsername", "actorAvatarKey", "message", "timeLabel", "section", "isFollowAction", "isFollowingBack", "isUnread", "createdAt"]
    },
    "MessageThread": {
      "title": "MessageThread",
      "description": "Shared 1:1 direct message conversation thread between two participantUids.",
      "type": "object",
      "properties": {
        "participantUids": { "type": "array", "items": { "type": "string" } },
        "userAId": { "type": "string" },
        "userAUsername": { "type": "string" },
        "userADisplayName": { "type": "string" },
        "userAAvatarKey": { "type": "string" },
        "userBId": { "type": "string" },
        "userBUsername": { "type": "string" },
        "userBDisplayName": { "type": "string" },
        "userBAvatarKey": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastSenderUid": { "type": "string" },
        "unreadUid": { "type": "string" },
        "timeLabel": { "type": "string" },
        "unreadCount": { "type": "integer" },
        "isOnline": { "type": "boolean" },
        "noteText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["participantUids", "userAId", "userAUsername", "userADisplayName", "userAAvatarKey", "userBId", "userBUsername", "userBDisplayName", "userBAvatarKey", "lastMessage", "lastSenderUid", "unreadUid", "timeLabel", "unreadCount", "isOnline", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a shared 1:1 direct message thread.",
      "type": "object",
      "properties": {
        "participantUids": { "type": "array", "items": { "type": "string" } },
        "senderUid": { "type": "string" },
        "senderUsername": { "type": "string" },
        "text": { "type": "string" },
        "messageType": { "type": "string", "enum": ["TEXT", "IMAGE", "VIDEO", "AUDIO"] },
        "imageData": { "type": "string" },
        "videoData": { "type": "string" },
        "videoDurationMs": { "type": "integer" },
        "audioData": { "type": "string" },
        "audioDurationMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["participantUids", "senderUid", "senderUsername", "text", "createdAt"]
    },
    "LiveStream": {
      "title": "LiveStream",
      "description": "Active or recently ended Momi Live broadcast room synced across devices.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarKey": { "type": "string" },
        "authorVerified": { "type": "boolean" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "isLive": { "type": "boolean" },
        "viewerCount": { "type": "integer" },
        "likesCount": { "type": "integer" },
        "giftsCredits": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "username", "displayName", "avatarKey", "authorVerified", "title", "category", "isLive", "viewerCount", "likesCount", "createdAt"]
    },
    "LiveFrame": {
      "title": "LiveFrame",
      "description": "Rolling live camera frame and broadcast A/V state published by the host for real-time viewer playback.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "seq": { "type": "integer" },
        "frameData": { "type": "string" },
        "cameraEnabled": { "type": "boolean" },
        "micMuted": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "seq", "frameData", "cameraEnabled", "micMuted", "updatedAt"]
    },
    "LiveComment": {
      "title": "LiveComment",
      "description": "Real-time chat message in a Momi Live room.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "avatarKey": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "username", "avatarKey", "text", "createdAt"]
    },
    "MerchantAccount": {
      "title": "MerchantAccount",
      "description": "Momi Marketplace merchant storefront verified exclusively by admin.",

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email == 'syali6511@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function requesterUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRequesterProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function requesterRole() {
      return hasRequesterProfile() && ('role' in requesterUserDoc()) ? requesterUserDoc().role : 'USER';
    }

    function hasModerationScope(scope) {
      return hasRequesterProfile() &&
             ('moderationScopes' in requesterUserDoc()) &&
             requesterUserDoc().moderationScopes is list &&
             scope in requesterUserDoc().moderationScopes;
    }

    function isModerator() {
      return requesterRole() == 'MODERATOR' &&
             ('moderationScopes' in requesterUserDoc()) &&
             requesterUserDoc().moderationScopes is list &&
             requesterUserDoc().moderationScopes.size() > 0;
    }

    function isEditor() {
      return requesterRole() == 'EDITOR' &&
             ('moderationScopes' in requesterUserDoc()) &&
             requesterUserDoc().moderationScopes is list &&
             requesterUserDoc().moderationScopes.size() > 0;
    }

    function isTeamStaff() {
      return isAdmin() || isModerator() || isEditor();
    }

    // Entity Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 50 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 80)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('website' in data) || (data.website is string && data.website.size() <= 200)) &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             (!('avatarData' in data) || data.avatarData == null || (data.avatarData is string && data.avatarData.size() <= 200000)) &&
             data.followersCount is int && data.followersCount >= 0 &&
             data.followingCount is int && data.followingCount >= 0 &&
             data.isVerified is bool &&
             (!('role' in data) || (data.role is string && data.role in ['USER', 'MODERATOR', 'EDITOR'])) &&
             (!('moderationScopes' in data) || (data.moderationScopes is list && data.moderationScopes.size() <= 6 && (data.moderationScopes.size() == 0 || data.moderationScopes[0] is string))) &&
             (!('assignedByEmail' in data) || data.assignedByEmail == null || (data.assignedByEmail is string && data.assignedByEmail.size() <= 120)) &&
             (!('partnerConsent' in data) || data.partnerConsent is bool) &&
             (!('consentUpdatedAt' in data) || data.consentUpdatedAt == null || (data.consentUpdatedAt is timestamp && data.consentUpdatedAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidPost(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 50 &&
             data.authorDisplayName is string && data.authorDisplayName.size() >= 1 && data.authorDisplayName.size() <= 80 &&
             data.authorAvatarKey is string && data.authorAvatarKey.size() >= 1 && data.authorAvatarKey.size() <= 64 &&
             data.authorVerified is bool &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 64 &&
             (!('localImagePath' in data) || data.localImagePath == null || (data.localImagePath is string && data.localImagePath.size() <= 500)) &&
             (!('imageData' in data) || data.imageData == null || (data.imageData is string && data.imageData.size() <= 700000)) &&
             (!('localExtraImagePaths' in data) || data.localExtraImagePaths == null || (data.localExtraImagePaths is list && data.localExtraImagePaths.size() <= 4)) &&
             (!('extraImageDatas' in data) || data.extraImageDatas == null || (data.extraImageDatas is list && data.extraImageDatas.size() <= 4)) &&
             (!('mediaType' in data) || data.mediaType == null || (data.mediaType is string && data.mediaType in ['IMAGE', 'VIDEO'])) &&
             (!('localVideoPath' in data) || data.localVideoPath == null || (data.localVideoPath is string && data.localVideoPath.size() <= 500)) &&
             (!('videoData' in data) || data.videoData == null || (data.videoData is string && data.videoData.size() <= 700000)) &&
             (!('videoChunksCount' in data) || data.videoChunksCount == null || (data.videoChunksCount is int && data.videoChunksCount >= 0 && data.videoChunksCount <= 25)) &&
             (!('videoDurationMs' in data) || data.videoDurationMs == null || (data.videoDurationMs is int && data.videoDurationMs >= 0 && data.videoDurationMs <= 3600000)) &&
             data.filterTag is string && data.filterTag in ['NONE', 'BLUE', 'MAROON', 'MONO', 'WARM', 'VINTAGE', 'VIVID', 'NOIR', 'CINEMA', 'PASTEL'] &&
             (!('aspectRatio' in data) || data.aspectRatio == null || (data.aspectRatio is string && data.aspectRatio in ['1:1', '4:5', '16:9'])) &&
             (!('taggedUsernames' in data) || data.taggedUsernames == null || (data.taggedUsernames is list && data.taggedUsernames.size() <= 10 && (data.taggedUsernames.size() == 0 || (data.taggedUsernames[0] is string && data.taggedUsernames[0].size() <= 50)))) &&
             (!('hashtags' in data) || data.hashtags == null || (data.hashtags is list && data.hashtags.size() <= 15 && (data.hashtags.size() == 0 || (data.hashtags[0] is string && data.hashtags[0].size() <= 40)))) &&
             data.caption is string && data.caption.size() <= 1000 &&
             data.likesCount is int && data.likesCount >= 0 &&
             (!('viewsCount' in data) || data.viewsCount == null || (data.viewsCount is int && data.viewsCount >= 0)) &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.isReel is bool &&
             (!('audioTitle' in data) || (data.audioTitle is string && data.audioTitle.size() <= 120)) &&
             (!('localAudioPath' in data) || data.localAudioPath == null || (data.localAudioPath is string && data.localAudioPath.size() <= 500)) &&
             (!('audioData' in data) || data.audioData == null || (data.audioData is string && data.audioData.size() <= 660000)) &&
             (!('isBoosted' in data) || data.isBoosted is bool) &&
             (!('boostTier' in data) || data.boostTier == null || (data.boostTier is string && data.boostTier in ['', 'SPOTLIGHT', 'SUPER_BOOST', 'OWNER_RECOMMENDED'])) &&
             (!('recommendedLabel' in data) || data.recommendedLabel == null || (data.recommendedLabel is string && data.recommendedLabel.size() <= 40)) &&
             (!('boostedByUid' in data) || data.boostedByUid == null || (data.boostedByUid is string && data.boostedByUid.size() <= 128)) &&
             (!('boostedAt' in data) || data.boostedAt == null || (data.boostedAt is timestamp && data.boostedAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidComment(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 50 &&
             data.authorAvatarKey is string && data.authorAvatarKey.size() >= 1 && data.authorAvatarKey.size() <= 64 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidStory(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 50 &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 64 &&
             (!('localImagePath' in data) || data.localImagePath == null || (data.localImagePath is string && data.localImagePath.size() <= 500)) &&
             (!('imageData' in data) || data.imageData == null || (data.imageData is string && data.imageData.size() <= 700000)) &&
             (!('mediaType' in data) || data.mediaType == null || (data.mediaType is string && data.mediaType in ['IMAGE', 'VIDEO'])) &&
             (!('localVideoPath' in data) || data.localVideoPath == null || (data.localVideoPath is string && data.localVideoPath.size() <= 500)) &&
             (!('videoData' in data) || data.videoData == null || (data.videoData is string && data.videoData.size() <= 700000)) &&
             (!('videoChunksCount' in data) || data.videoChunksCount == null || (data.videoChunksCount is int && data.videoChunksCount >= 0 && data.videoChunksCount <= 25)) &&
             (!('videoDurationMs' in data) || data.videoDurationMs == null || (data.videoDurationMs is int && data.videoDurationMs >= 0 && data.videoDurationMs <= 3600000)) &&
             (!('audioTitle' in data) || data.audioTitle == null || (data.audioTitle is string && data.audioTitle.size() <= 120)) &&
             (!('localAudioPath' in data) || data.localAudioPath == null || (data.localAudioPath is string && data.localAudioPath.size() <= 500)) &&
             (!('audioData' in data) || data.audioData == null || (data.audioData is string && data.audioData.size() <= 660000)) &&
             data.caption is string && data.caption.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidVideoChunk(data) {
      return data.index is int &&
             data.index >= 0 &&
             data.index < 25 &&
             data.data is string &&
             data.data.size() >= 1 &&
             data.data.size() <= 700000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidFollow(data, followId) {
      return data.followerUid is string && isValidId(data.followerUid) &&
             data.targetUid is string && isValidId(data.targetUid) &&
             data.followerUid != data.targetUid &&
             followId == data.followerUid + '_' + data.targetUid &&
             data.followerUsername is string && data.followerUsername.size() >= 1 && data.followerUsername.size() <= 50 &&
             data.targetUsername is string && data.targetUsername.size() >= 1 && data.targetUsername.size() <= 50 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidInteractionMarker(data, targetId) {
      return data.targetId is string && data.targetId == targetId &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidNotification(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.actorUid is string && isValidId(data.actorUid) &&
             data.actorUsername is string && data.actorUsername.size() >= 1 && data.actorUsername.size() <= 50 &&
             data.actorAvatarKey is string && data.actorAvatarKey.size() >= 1 && data.actorAvatarKey.size() <= 64 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 300 &&
             data.timeLabel is string && data.timeLabel.size() >= 1 && data.timeLabel.size() <= 30 &&
             data.section is string && data.section.size() >= 1 && data.section.size() <= 30 &&
             (!('previewImageKey' in data) || data.previewImageKey == null || (data.previewImageKey is string && data.previewImageKey.size() <= 64)) &&
             data.isFollowAction is bool &&
             data.isFollowingBack is bool &&
             data.isUnread is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMessageThread(data) {
      return data.participantUids is list &&
             data.participantUids.size() == 2 &&
             data.participantUids[0] is string && isValidId(data.participantUids[0]) &&
             data.participantUids[1] is string && isValidId(data.participantUids[1]) &&
             data.participantUids[0] != data.participantUids[1] &&
             data.userAId is string && data.userAId == data.participantUids[0] &&
             data.userBId is string && data.userBId == data.participantUids[1] &&
             data.userAUsername is string && data.userAUsername.size() >= 1 && data.userAUsername.size() <= 50 &&
             data.userADisplayName is string && data.userADisplayName.size() >= 1 && data.userADisplayName.size() <= 80 &&
             data.userAAvatarKey is string && data.userAAvatarKey.size() >= 1 && data.userAAvatarKey.size() <= 64 &&
             data.userBUsername is string && data.userBUsername.size() >= 1 && data.userBUsername.size() <= 50 &&
             data.userBDisplayName is string && data.userBDisplayName.size() >= 1 && data.userBDisplayName.size() <= 80 &&
             data.userBAvatarKey is string && data.userBAvatarKey.size() >= 1 && data.userBAvatarKey.size() <= 64 &&
             data.lastMessage is string && data.lastMessage.size() <= 500 &&
             data.lastSenderUid is string && data.lastSenderUid.size() <= 128 &&
             data.unreadUid is string && data.unreadUid.size() <= 128 &&
             data.timeLabel is string && data.timeLabel.size() >= 1 && data.timeLabel.size() <= 30 &&
             data.unreadCount is int && data.unreadCount >= 0 &&
             data.isOnline is bool &&
             (!('noteText' in data) || data.noteText == null || (data.noteText is string && data.noteText.size() <= 100)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatMessage(data) {
      return data.participantUids is list &&
             data.participantUids.size() == 2 &&
             data.participantUids[0] is string &&
             data.participantUids[1] is string &&
             data.senderUid is string && isValidId(data.senderUid) &&
             data.senderUid in data.participantUids &&
             data.senderUsername is string && data.senderUsername.size() >= 1 && data.senderUsername.size() <= 50 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             (!('messageType' in data) || (data.messageType is string && data.messageType in ['TEXT', 'IMAGE', 'VIDEO', 'AUDIO'])) &&
             (!('imageData' in data) || data.imageData == null || (data.imageData is string && data.imageData.size() <= 700000)) &&
             (!('videoData' in data) || data.videoData == null || (data.videoData is string && data.videoData.size() <= 700000)) &&
             (!('videoDurationMs' in data) || data.videoDurationMs == null || (data.videoDurationMs is int && data.videoDurationMs >= 0 && data.videoDurationMs <= 3600000)) &&
             (!('audioData' in data) || data.audioData == null || (data.audioData is string && data.audioData.size() <= 660000)) &&
             (!('audioDurationMs' in data) || data.audioDurationMs == null || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 600000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLiveStream(data, streamId) {
      return data.userId is string && data.userId == streamId && isValidId(data.userId) &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 50 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             data.authorVerified is bool &&
             data.title is string && data.title.size() <= 140 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.isLive is bool &&
             data.viewerCount is int && data.viewerCount >= 0 &&
             data.likesCount is int && data.likesCount >= 0 &&
             (!('giftsCredits' in data) || (data.giftsCredits is int && data.giftsCredits >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidLiveFrame(data, streamId) {
      return data.userId is string && data.userId == streamId && isValidId(data.userId) &&
             data.seq is int && data.seq >= 0 &&
             data.frameData is string && data.frameData.size() <= 220000 &&
             data.cameraEnabled is bool &&
             data.micMuted is bool &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLiveComment(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 50 &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserWallet(data, userId) {
      return data.userId is string && data.userId == userId && isValidId(data.userId) &&
             data.balance is int && data.balance >= 0 &&
             data.totalEarned is int && data.totalEarned >= 0 &&
             data.totalSpent is int && data.totalSpent >= 0 &&
             data.totalPurchased is int && data.totalPurchased >= 0 &&
             data.accountTier is string && data.accountTier in ['STANDARD', 'SUPPORTER', 'CREATOR_PRO', 'VIP'] &&
             data.verificationTier is string && data.verificationTier in ['NONE', 'PENDING_PERK', 'CREATOR_PRO', 'VERIFIED'] &&
             data.unlockedPerks is list && data.unlockedPerks.size() <= 20 &&
             (data.unlockedPerks.size() == 0 || data.unlockedPerks[0] is string) &&
             (!('lastTxId' in data) || data.lastTxId == null || (data.lastTxId is string && isValidId(data.lastTxId))) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidCreditTransaction(data, txId) {
      return data.txId is string && data.txId == txId && isValidId(txId) &&
             data.type is string && data.type in ['TOP_UP', 'GIFT', 'PERK_UNLOCK', 'POST_BOOST', 'OWNER_GRANT'] &&
             data.senderUid is string && isValidId(data.senderUid) &&
             data.senderUsername is string && data.senderUsername.size() >= 1 && data.senderUsername.size() <= 50 &&
             data.recipientUid is string && isValidId(data.recipientUid) &&
             data.recipientUsername is string && data.recipientUsername.size() >= 1 && data.recipientUsername.size() <= 50 &&
             data.creditsAmount is int && data.creditsAmount >= 0 && data.creditsAmount <= 5000 &&
             (data.priceUsd is int || data.priceUsd is float) && data.priceUsd >= 0 &&
             data.paymentMethod is string && data.paymentMethod in ['GOOGLE_PLAY', 'DEBUG_SANDBOX', 'WALLET_CREDITS', 'OWNER_ADMIN'] &&
             (!('paymentRef' in data) || data.paymentRef == null || (data.paymentRef is string && data.paymentRef.size() <= 200)) &&
             (!('giftKey' in data) || data.giftKey == null || (data.giftKey is string && data.giftKey.size() <= 64)) &&
             (!('giftName' in data) || data.giftName == null || (data.giftName is string && data.giftName.size() <= 64)) &&
             (!('streamId' in data) || data.streamId == null || (data.streamId is string && isValidId(data.streamId))) &&
             (!('perkKey' in data) || data.perkKey == null || (data.perkKey is string && data.perkKey.size() <= 64)) &&
             (!('postId' in data) || data.postId == null || (data.postId is string && data.postId.size() <= 128)) &&
             data.recipientClaimed is bool &&
             data.status is string && data.status in ['COMPLETED', 'PENDING'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidWalletTopUp(userId) {
      let txId = incoming().lastTxId;
      let txPath = /databases/$(database)/documents/creditTransactions/$(txId);
      let tx = getAfter(txPath).data;
      return txId is string && isValidId(txId) &&
             !exists(txPath) && existsAfter(txPath) &&
             tx.type == 'TOP_UP' &&
             tx.senderUid == userId &&
             tx.recipientUid == userId &&
             tx.creditsAmount is int &&
             tx.creditsAmount in [50, 200, 500, 1200, 3000] &&
             incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalPurchased', 'accountTier', 'lastTxId', 'updatedAt']) &&
             incoming().balance == existing().balance + tx.creditsAmount &&
             incoming().totalPurchased == existing().totalPurchased + tx.creditsAmount;
    }

    function isValidWalletGiftSend(userId) {
      let txId = incoming().lastTxId;
      let txPath = /databases/$(database)/documents/creditTransactions/$(txId);
      let tx = getAfter(txPath).data;
      return txId is string && isValidId(txId) &&
             !exists(txPath) && existsAfter(txPath) &&
             tx.type == 'GIFT' &&
             tx.senderUid == userId &&
             tx.recipientUid != userId &&
             tx.creditsAmount is int &&
             tx.creditsAmount > 0 && tx.creditsAmount <= 5000 &&
             incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalSpent', 'lastTxId', 'updatedAt']) &&
             incoming().balance == existing().balance - tx.creditsAmount &&
             incoming().totalSpent == existing().totalSpent + tx.creditsAmount;
    }

    function isValidWalletGiftClaim(userId) {
      let txId = incoming().lastTxId;
      let txPath = /databases/$(database)/documents/creditTransactions/$(txId);
      let txBefore = get(txPath).data;
      let txAfter = getAfter(txPath).data;
      return txId is string && isValidId(txId) &&
             exists(txPath) && existsAfter(txPath) &&
             txBefore.type == 'GIFT' &&
             txBefore.recipientUid == userId &&
             txBefore.recipientClaimed == false &&
             txAfter.recipientClaimed == true &&
             incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalEarned', 'lastTxId', 'updatedAt']) &&
             incoming().balance == existing().balance + txBefore.creditsAmount &&
             incoming().totalEarned == existing().totalEarned + txBefore.creditsAmount;
    }

    function isValidWalletPerkUnlock(userId) {
      let txId = incoming().lastTxId;
      let txPath = /databases/$(database)/documents/creditTransactions/$(txId);
      let tx = getAfter(txPath).data;
      return txId is string && isValidId(txId) &&
             !exists(txPath) && existsAfter(txPath) &&
             tx.type == 'PERK_UNLOCK' &&
             tx.senderUid == userId &&
             tx.recipientUid == userId &&
             tx.creditsAmount is int &&
             tx.creditsAmount in [100, 250, 500, 1000] &&
             incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalSpent', 'accountTier', 'verificationTier', 'unlockedPerks', 'lastTxId', 'updatedAt']) &&
             incoming().balance == existing().balance - tx.creditsAmount &&
             incoming().totalSpent == existing().totalSpent + tx.creditsAmount &&
             incoming().unlockedPerks.size() >= existing().unlockedPerks.size() &&
             incoming().unlockedPerks.size() <= existing().unlockedPerks.size() + 1;
    }

    function isValidWalletPostBoost(userId) {
      let txId = incoming().lastTxId;
      let txPath = /databases/$(database)/documents/creditTransactions/$(txId);
      let tx = getAfter(txPath).data;
      return txId is string && isValidId(txId) &&
             !exists(txPath) && existsAfter(txPath) &&
             tx.type == 'POST_BOOST' &&
             tx.senderUid == userId &&
             tx.recipientUid == userId &&
             tx.creditsAmount is int &&
             tx.creditsAmount in [100, 250, 500] &&
             incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalSpent', 'lastTxId', 'updatedAt']) &&
             incoming().balance == existing().balance - tx.creditsAmount &&
             incoming().totalSpent == existing().totalSpent + tx.creditsAmount;
    }

    function isValidAdminOwnerGrant(userId) {
      let txId = incoming().lastTxId;
      let txPath = /databases/$(database)/documents/creditTransactions/$(txId);
      let tx = getAfter(txPath).data;
      return isAdmin() &&
             txId is string && isValidId(txId) &&
             !exists(txPath) && existsAfter(txPath) &&
             tx.type == 'OWNER_GRANT' &&
             tx.recipientUid == userId &&
             tx.paymentMethod == 'OWNER_ADMIN' &&
             tx.creditsAmount is int &&
             tx.creditsAmount >= 0 && tx.creditsAmount <= 5000 &&
             incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalEarned', 'accountTier', 'verificationTier', 'unlockedPerks', 'lastTxId', 'updatedAt']) &&
             incoming().balance == existing().balance + tx.creditsAmount &&
             incoming().totalEarned == existing().totalEarned + tx.creditsAmount &&
             incoming().unlockedPerks.size() >= existing().unlockedPerks.size();
    }

    function isValidAdminOwnerWalletCreate(userId) {
      let txId = incoming().lastTxId;
      let txPath = /databases/$(database)/documents/creditTransactions/$(txId);
      let tx = getAfter(txPath).data;
      return isAdmin() &&
             txId is string && isValidId(txId) &&
             !exists(txPath) && existsAfter(txPath) &&
             tx.type == 'OWNER_GRANT' &&
             tx.recipientUid == userId &&
             tx.paymentMethod == 'OWNER_ADMIN' &&
             tx.creditsAmount is int &&
             tx.creditsAmount >= 0 && tx.creditsAmount <= 5000 &&
             incoming().balance == tx.creditsAmount &&
             incoming().totalEarned == tx.creditsAmount &&
             incoming().totalSpent == 0 &&
             incoming().totalPurchased == 0;
    }

    function isValidAppConfig(data) {
      return data.admobEnabled is bool &&
             data.admobBannerUnitId is string && data.admobBannerUnitId.size() <= 120 &&
             data.admobMrecUnitId is string && data.admobMrecUnitId.size() <= 120 &&
             data.admobInterstitialUnitId is string && data.admobInterstitialUnitId.size() <= 120 &&
             data.startIoEnabled is bool &&
             data.monetagEnabled is bool &&
             data.monetagDirectLinkUrl is string && data.monetagDirectLinkUrl.size() <= 300 &&
             (data.monetagDirectLinkUrl == '' || data.monetagDirectLinkUrl.matches('^https://.*')) &&
             data.monetagWebZoneId is string && data.monetagWebZoneId.size() <= 40 &&
             data.monetagWebMetaTag is string && data.monetagWebMetaTag.size() <= 120 &&
             data.partnerPromoTitle is string && data.partnerPromoTitle.size() <= 80 &&
             data.partnerPromoSubtitle is string && data.partnerPromoSubtitle.size() <= 180 &&
             data.partnerPromoCta is string && data.partnerPromoCta.size() <= 40 &&
             (!('gamezopEnabled' in data) || data.gamezopEnabled is bool) &&
             (!('gamezopPortalUrl' in data) || (data.gamezopPortalUrl is string && data.gamezopPortalUrl.size() <= 300 && (data.gamezopPortalUrl == '' || data.gamezopPortalUrl.matches('^https://.*')))) &&
             (!('gamezopPublisherId' in data) || (data.gamezopPublisherId is string && data.gamezopPublisherId.size() <= 40)) &&
             (!('gamezopBannerTitle' in data) || (data.gamezopBannerTitle is string && data.gamezopBannerTitle.size() <= 80)) &&
             data.updatedByEmail is string && data.updatedByEmail.size() <= 120 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMerchant(data, merchantId) {
      return data.userId is string && data.userId == merchantId && isValidId(data.userId) &&
             data.ownerUsername is string && data.ownerUsername.size() >= 1 && data.ownerUsername.size() <= 50 &&
             data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
             data.tagline is string && data.tagline.size() <= 160 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.location is string && data.location.size() <= 120 &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             (!('avatarData' in data) || data.avatarData == null || (data.avatarData is string && data.avatarData.size() <= 200000)) &&
             data.isVerified is bool &&
             (!('verifiedByEmail' in data) || data.verifiedByEmail == null || (data.verifiedByEmail is string && data.verifiedByEmail.size() <= 120)) &&
             data.totalSales is int && data.totalSales >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMarketProduct(data) {
      return data.sellerUid is string && isValidId(data.sellerUid) &&
             data.sellerUsername is string && data.sellerUsername.size() >= 1 && data.sellerUsername.size() <= 50 &&
             data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 1000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             (data.priceUsd is int || data.priceUsd is float) && data.priceUsd > 0 &&
             (data.originalPriceUsd is int || data.originalPriceUsd is float) && data.originalPriceUsd >= 0 &&
             data.discountPercent is int && data.discountPercent >= 0 && data.discountPercent <= 95 &&
             data.freeShipping is bool &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 64 &&
             (!('imageData' in data) || data.imageData == null || (data.imageData is string && data.imageData.size() <= 700000)) &&
             (!('extraImageDatas' in data) || data.extraImageDatas == null || (data.extraImageDatas is list && data.extraImageDatas.size() <= 4)) &&
             (!('videoData' in data) || data.videoData == null || (data.videoData is string && data.videoData.size() <= 700000)) &&
             (!('videoChunksCount' in data) || data.videoChunksCount == null || (data.videoChunksCount is int && data.videoChunksCount >= 0 && data.videoChunksCount <= 25)) &&
             data.videoDurationMs is int && data.videoDurationMs >= 0 && data.videoDurationMs <= 3600000 &&
             data.stockCount is int && data.stockCount >= 0 && data.stockCount <= 99999 &&
             (!('isFeatured' in data) || data.isFeatured is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidContentReport(data) {
      return data.reporterUid is string && isValidId(data.reporterUid) &&
             data.reporterUsername is string && data.reporterUsername.size() >= 1 && data.reporterUsername.size() <= 50 &&
             data.targetType is string && data.targetType in ['POST', 'PRODUCT', 'COMMENT', 'USER'] &&
             data.targetId is string && isValidId(data.targetId) &&
             (!('targetAuthorUid' in data) || data.targetAuthorUid == null || (data.targetAuthorUid is string && data.targetAuthorUid.size() <= 128)) &&
             data.targetAuthorUsername is string && data.targetAuthorUsername.size() <= 50 &&
             data.targetPreviewText is string && data.targetPreviewText.size() <= 240 &&
             data.category is string && data.category in ['VIOLENCE_GRAPHIC', 'SEXUAL_NUDITY', 'HARASSMENT_SPAM', 'MARKETPLACE_SAFETY'] &&
             data.reasonDetail is string && data.reasonDetail.size() <= 400 &&
             data.status is string && data.status in ['OPEN', 'REMOVED', 'DISMISSED'] &&
             (!('reviewedByUid' in data) || data.reviewedByUid == null || (data.reviewedByUid is string && isValidId(data.reviewedByUid))) &&
             (!('reviewedByUsername' in data) || data.reviewedByUsername == null || (data.reviewedByUsername is string && data.reviewedByUsername.size() <= 50)) &&
             (!('reviewedByRole' in data) || data.reviewedByRole == null || (data.reviewedByRole is string && data.reviewedByRole in ['ADMIN', 'MODERATOR', 'EDITOR'])) &&
             (!('resolutionNote' in data) || data.resolutionNote == null || (data.resolutionNote is string && data.resolutionNote.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMarketOrder(data) {
      return data.buyerUid is string && isValidId(data.buyerUid) &&
             data.buyerUsername is string && data.buyerUsername.size() >= 1 && data.buyerUsername.size() <= 50 &&
             data.sellerUid is string && isValidId(data.sellerUid) &&
             data.buyerUid != data.sellerUid &&
             data.sellerStoreName is string && data.sellerStoreName.size() >= 1 && data.sellerStoreName.size() <= 80 &&
             data.productId is string && isValidId(data.productId) &&
             data.productTitle is string && data.productTitle.size() >= 1 && data.productTitle.size() <= 120 &&
             data.productImageKey is string && data.productImageKey.size() >= 1 && data.productImageKey.size() <= 64 &&
             (!('productImageData' in data) || data.productImageData == null || (data.productImageData is string && data.productImageData.size() <= 700000)) &&
             (data.priceUsd is int || data.priceUsd is float) && data.priceUsd > 0 &&
             data.shippingAddress is string && data.shippingAddress.size() >= 1 && data.shippingAddress.size() <= 300 &&
             data.status is string && data.status in ['PLACED', 'SHIPPED', 'DELIVERED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Public creator profiles (strictly no PII) + owner-isolated private subcollections
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'username', 'displayName', 'avatarKey', 'followersCount', 'followingCount', 'isVerified', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'displayName', 'category', 'bio', 'website', 'avatarKey', 'avatarData', 'followersCount', 'followingCount', 'isVerified', 'role', 'moderationScopes', 'assignedByEmail', 'partnerConsent', 'consentUpdatedAt', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId) &&
                       (incoming().isVerified == false || isAdmin()) &&
                       (!('role' in incoming()) || incoming().role == 'USER' || isAdmin()) &&
                       (!('moderationScopes' in incoming()) || incoming().moderationScopes.size() == 0 || isAdmin()) &&
                       (!('assignedByEmail' in incoming()) || incoming().assignedByEmail == null || isAdmin());

      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isOwner(userId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'category', 'bio', 'website', 'avatarKey', 'avatarData', 'partnerConsent', 'consentUpdatedAt', 'updatedAt'])) ||
                         (isAdmin() &&
                          (
                            incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'updatedAt']) ||
                            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'moderationScopes', 'assignedByEmail', 'updatedAt'])
                          ))
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /likedPosts/{postId} {
        allow get: if isOwner(userId) && isValidId(postId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(postId) &&
                         incoming().keys().hasAll(['targetId', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetId', 'createdAt']) &&
                         isValidInteractionMarker(incoming(), postId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(postId);
      }

      match /bookmarks/{postId} {
        allow get: if isOwner(userId) && isValidId(postId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(postId) &&
                         incoming().keys().hasAll(['targetId', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetId', 'createdAt']) &&
                         isValidInteractionMarker(incoming(), postId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(postId);
      }

      match /seenStories/{storyId} {
        allow get: if isOwner(userId) && isValidId(storyId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(storyId) &&
                         incoming().keys().hasAll(['targetId', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetId', 'createdAt']) &&
                         isValidInteractionMarker(incoming(), storyId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(storyId);
      }

      match /likedComments/{commentId} {
        allow get: if isOwner(userId) && isValidId(commentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(commentId) &&
                         incoming().keys().hasAll(['targetId', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetId', 'createdAt']) &&
                         isValidInteractionMarker(incoming(), commentId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(commentId);
      }

      match /notifications/{notificationId} {
        allow get: if isOwner(userId) && isValidId(notificationId);
        allow list: if isOwner(userId);

        // Recipient can only see their own notifications; any signed-in actor can send a notification to userId
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(notificationId) &&
                         incoming().actorUid == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'actorUid', 'actorUsername', 'actorAvatarKey', 'message', 'timeLabel', 'section', 'isFollowAction', 'isFollowingBack', 'isUnread', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'actorUid', 'actorUsername', 'actorAvatarKey', 'message', 'timeLabel', 'section', 'previewImageKey', 'isFollowAction', 'isFollowingBack', 'isUnread', 'createdAt', 'updatedAt']) &&
                         isValidNotification(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(notificationId) &&
                         isValidNotification(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().actorUid == existing().actorUid &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['isFollowingBack', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['isUnread', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(notificationId);
      }
    }

    // Global Shared Feed Posts & Clips
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'authorUsername', 'authorDisplayName', 'authorAvatarKey', 'authorVerified', 'imageKey', 'filterTag', 'caption', 'likesCount', 'commentsCount', 'category', 'isReel', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorUsername', 'authorDisplayName', 'authorAvatarKey', 'authorVerified', 'location', 'imageKey', 'localImagePath', 'imageData', 'localExtraImagePaths', 'extraImageDatas', 'mediaType', 'localVideoPath', 'videoData', 'videoChunksCount', 'videoDurationMs', 'localAudioPath', 'audioData', 'filterTag', 'aspectRatio', 'taggedUsernames', 'hashtags', 'caption', 'likesCount', 'viewsCount', 'commentsCount', 'category', 'isReel', 'audioTitle', 'isBoosted', 'boostTier', 'recommendedLabel', 'boostedByUid', 'boostedAt', 'createdAt', 'updatedAt']) &&
                       (!('isBoosted' in incoming()) || incoming().isBoosted == false || isAdmin()) &&
                       isValidPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidPost(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'location', 'taggedUsernames', 'hashtags', 'updatedAt'])) ||
                         (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isBoosted', 'boostTier', 'recommendedLabel', 'boostedByUid', 'boostedAt', 'updatedAt'])) ||
                         (existing().userId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isBoosted', 'boostTier', 'recommendedLabel', 'boostedByUid', 'boostedAt', 'updatedAt']) &&
                          (!('boostTier' in incoming()) || incoming().boostTier in ['', 'SPOTLIGHT', 'SUPER_BOOST']) &&
                          (incoming().isBoosted == false ||
                           (existsAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)) &&
                            getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.totalSpent > get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.totalSpent))) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                           (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1)) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt']) &&
                           ((('viewsCount' in existing()) && existing().viewsCount is int && incoming().viewsCount == existing().viewsCount + 1) ||
                            (!('viewsCount' in existing()) && incoming().viewsCount == 1))) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) &&
                           (incoming().commentsCount == existing().commentsCount + 1 || incoming().commentsCount == existing().commentsCount - 1))
                       );

      allow delete: if isSignedIn() && isValidId(postId) && (
        existing().userId == request.auth.uid ||
        isAdmin() ||
        isModerator()
      );

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(postId);

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'authorUsername', 'authorAvatarKey', 'text', 'likesCount', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'authorUsername', 'authorAvatarKey', 'text', 'likesCount', 'createdAt', 'updatedAt']) &&
                         isValidComment(incoming()) &&
                         exists(/databases/$(database)/documents/posts/$(postId));

        allow update: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         isValidComment(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                         (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1);

        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         (existing().userId == request.auth.uid ||
                          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid ||
                          isAdmin() ||
                          isModerator());
      }

      match /videoChunks/{chunkId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(chunkId);
        allow list: if isSignedIn() && isValidId(postId);
        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(chunkId) &&
                         incoming().keys().hasAll(['index', 'data', 'createdAt']) &&
                         incoming().keys().hasOnly(['index', 'data', 'createdAt']) &&
                         isValidVideoChunk(incoming()) &&
                         exists(/databases/$(database)/documents/posts/$(postId)) &&
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(chunkId) &&
                         (isAdmin() || isModerator() ||
                          (exists(/databases/$(database)/documents/posts/$(postId)) &&
                           get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid));
      }
    }

    // Global Shared Stories
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'avatarKey', 'imageKey', 'caption', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'avatarKey', 'imageKey', 'localImagePath', 'imageData', 'mediaType', 'localVideoPath', 'videoData', 'videoChunksCount', 'videoDurationMs', 'audioTitle', 'localAudioPath', 'audioData', 'caption', 'createdAt', 'updatedAt']) &&
                       isValidStory(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(storyId) && existing().userId == request.auth.uid;

      match /videoChunks/{chunkId} {
        allow get: if isSignedIn() && isValidId(storyId) && isValidId(chunkId);
        allow list: if isSignedIn() && isValidId(storyId);
        allow create: if isSignedIn() &&
                         isValidId(storyId) &&
                         isValidId(chunkId) &&
                         incoming().keys().hasAll(['index', 'data', 'createdAt']) &&
                         incoming().keys().hasOnly(['index', 'data', 'createdAt']) &&
                         isValidVideoChunk(incoming()) &&
                         exists(/databases/$(database)/documents/stories/$(storyId)) &&
                         get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(storyId) &&
                         isValidId(chunkId) &&
                         exists(/databases/$(database)/documents/stories/$(storyId)) &&
                         get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }
    }

    // Shared Follow Graph
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(followId) &&
                       incoming().followerUid == request.auth.uid &&
                       incoming().keys().hasAll(['followerUid', 'targetUid', 'followerUsername', 'targetUsername', 'createdAt']) &&
                       incoming().keys().hasOnly(['followerUid', 'targetUid', 'followerUsername', 'targetUsername', 'createdAt']) &&
                       isValidFollow(incoming(), followId);

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(followId) && existing().followerUid == request.auth.uid;
    }

    // Shared 1:1 Direct Message Threads (strictly participant-only)
    match /threads/{threadId} {
      allow get: if isSignedIn() && isValidId(threadId) && (
        (resource == null && (
          (threadId.size() > request.auth.uid.size() + 1 && threadId[0 : request.auth.uid.size() + 1] == request.auth.uid + '_') ||
          (threadId.size() > request.auth.uid.size() + 1 && threadId[threadId.size() - request.auth.uid.size() - 1 : threadId.size()] == '_' + request.auth.uid)
        )) ||
        (resource != null && request.auth.uid in existing().participantUids)
      );
      allow list: if isSignedIn() && request.auth.uid in existing().participantUids;

      allow create: if isSignedIn() &&
                       isValidId(threadId) &&
                       incoming().keys().hasAll(['participantUids', 'userAId', 'userAUsername', 'userADisplayName', 'userAAvatarKey', 'userBId', 'userBUsername', 'userBDisplayName', 'userBAvatarKey', 'lastMessage', 'lastSenderUid', 'unreadUid', 'timeLabel', 'unreadCount', 'isOnline', 'createdAt']) &&
                       incoming().keys().hasOnly(['participantUids', 'userAId', 'userAUsername', 'userADisplayName', 'userAAvatarKey', 'userBId', 'userBUsername', 'userBDisplayName', 'userBAvatarKey', 'lastMessage', 'lastSenderUid', 'unreadUid', 'timeLabel', 'unreadCount', 'isOnline', 'noteText', 'createdAt', 'updatedAt']) &&
                       isValidMessageThread(incoming()) &&
                       request.auth.uid in incoming().participantUids &&
                       threadId == incoming().userAId + '_' + incoming().userBId;

      allow update: if isSignedIn() &&
                       isValidId(threadId) &&
                       request.auth.uid in existing().participantUids &&
                       isValidMessageThread(incoming()) &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().userAId == existing().userAId &&
                       incoming().userBId == existing().userBId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['unreadUid', 'unreadCount', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'timeLabel', 'unreadUid', 'unreadCount', 'updatedAt'])
                       );

      allow delete: if isSignedIn() && isValidId(threadId) && request.auth.uid in existing().participantUids;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(threadId) && isValidId(messageId) && request.auth.uid in existing().participantUids;
        allow list: if isSignedIn() && isValidId(threadId) && request.auth.uid in existing().participantUids;

        allow create: if isSignedIn() &&
                         isValidId(threadId) &&
                         isValidId(messageId) &&
                         incoming().senderUid == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         incoming().keys().hasAll(['participantUids', 'senderUid', 'senderUsername', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['participantUids', 'senderUid', 'senderUsername', 'text', 'messageType', 'imageData', 'videoData', 'videoDurationMs', 'audioData', 'audioDurationMs', 'createdAt']) &&
                         isValidChatMessage(incoming()) &&
                         exists(/databases/$(database)/documents/threads/$(threadId)) &&
                         incoming().participantUids == get(/databases/$(database)/documents/threads/$(threadId)).data.participantUids;

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(threadId) && isValidId(messageId) && existing().senderUid == request.auth.uid;
      }
    }

    // Shared Momi Live Broadcast Rooms, Rolling Live Frames & Live Chat
    match /liveStreams/{streamId} {
      allow get: if isSignedIn() && isValidId(streamId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(streamId) &&
                       streamId == request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'displayName', 'avatarKey', 'authorVerified', 'title', 'category', 'isLive', 'viewerCount', 'likesCount', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'displayName', 'avatarKey', 'authorVerified', 'title', 'category', 'isLive', 'viewerCount', 'likesCount', 'giftsCredits', 'createdAt', 'updatedAt']) &&
                       isValidLiveStream(incoming(), streamId);

      allow update: if isSignedIn() &&
                       isValidId(streamId) &&
                       isValidLiveStream(incoming(), streamId) &&
                       incoming().userId == existing().userId &&
                       (
                         (existing().userId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'avatarKey', 'authorVerified', 'title', 'category', 'isLive', 'viewerCount', 'likesCount', 'giftsCredits', 'createdAt', 'updatedAt'])) ||
                         (incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['viewerCount', 'updatedAt']) &&
                           (incoming().viewerCount == existing().viewerCount + 1 || incoming().viewerCount == existing().viewerCount - 1)) ||
                         (incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                           incoming().likesCount == existing().likesCount + 1) ||
                         (incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['giftsCredits', 'updatedAt']) &&
                           incoming().giftsCredits is int &&
                           ((!('giftsCredits' in existing()) && incoming().giftsCredits > 0 && incoming().giftsCredits <= 5000) ||
                            (('giftsCredits' in existing()) && existing().giftsCredits is int && incoming().giftsCredits > existing().giftsCredits && incoming().giftsCredits <= existing().giftsCredits + 5000)))
                       );

      allow delete: if isSignedIn() && isValidId(streamId) && existing().userId == request.auth.uid;

      match /liveFrames/{frameId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(frameId);
        allow list: if isSignedIn() && isValidId(streamId);

        allow create: if isSignedIn() &&
                         isValidId(streamId) &&
                         frameId == 'latest' &&
                         streamId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'seq', 'frameData', 'cameraEnabled', 'micMuted', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'seq', 'frameData', 'cameraEnabled', 'micMuted', 'updatedAt']) &&
                         isValidLiveFrame(incoming(), streamId) &&
                         exists(/databases/$(database)/documents/liveStreams/$(streamId));

        allow update: if isSignedIn() &&
                         isValidId(streamId) &&
                         frameId == 'latest' &&
                         streamId == request.auth.uid &&
                         isValidLiveFrame(incoming(), streamId) &&
                         incoming().userId == existing().userId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'seq', 'frameData', 'cameraEnabled', 'micMuted', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(streamId) && streamId == request.auth.uid;
      }

      match /liveComments/{commentId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(streamId);

        allow create: if isSignedIn() &&
                         isValidId(streamId) &&
                         isValidId(commentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'username', 'avatarKey', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'username', 'avatarKey', 'text', 'createdAt']) &&
                         isValidLiveComment(incoming()) &&
                         exists(/databases/$(database)/documents/liveStreams/$(streamId));

        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(streamId) &&
                         isValidId(commentId) &&
                         (existing().userId == request.auth.uid || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.userId == request.auth.uid);
      }
    }

    // Momi Marketplace Merchants (admin-only verification)
    match /merchants/{merchantId} {
      allow get: if isSignedIn() && isValidId(merchantId);
      allow list: if isSignedIn();

      allow create: if isOwner(merchantId) &&
                       isValidId(merchantId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'ownerUsername', 'storeName', 'tagline', 'category', 'location', 'avatarKey', 'isVerified', 'totalSales', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'ownerUsername', 'storeName', 'tagline', 'category', 'location', 'avatarKey', 'avatarData', 'isVerified', 'verifiedByEmail', 'totalSales', 'createdAt', 'updatedAt']) &&
                       isValidMerchant(incoming(), merchantId) &&
                       incoming().isVerified == false &&
                       incoming().totalSales == 0;

      allow update: if isSignedIn() &&
                       isValidId(merchantId) &&
                       isValidMerchant(incoming(), merchantId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isOwner(merchantId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['storeName', 'tagline', 'category', 'location', 'avatarData', 'updatedAt'])) ||
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verifiedByEmail', 'updatedAt']))
                       );

      allow delete: if isOwner(merchantId) && isValidId(merchantId);
    }

    // Momi Marketplace Products & Chunked Product Videos
    match /marketProducts/{productId} {
      allow get: if isSignedIn() && isValidId(productId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(productId) &&
                       incoming().sellerUid == request.auth.uid &&
                       incoming().keys().hasAll(['sellerUid', 'sellerUsername', 'storeName', 'title', 'description', 'category', 'priceUsd', 'originalPriceUsd', 'discountPercent', 'freeShipping', 'imageKey', 'videoDurationMs', 'stockCount', 'createdAt']) &&
                       incoming().keys().hasOnly(['sellerUid', 'sellerUsername', 'storeName', 'title', 'description', 'category', 'priceUsd', 'originalPriceUsd', 'discountPercent', 'freeShipping', 'imageKey', 'imageData', 'extraImageDatas', 'videoData', 'videoChunksCount', 'videoDurationMs', 'stockCount', 'isFeatured', 'createdAt', 'updatedAt']) &&
                       (!('isFeatured' in incoming()) || incoming().isFeatured == false || isAdmin()) &&
                       isValidMarketProduct(incoming());

      allow update: if isSignedIn() &&
                       isValidId(productId) &&
                       isValidMarketProduct(incoming()) &&
                       incoming().sellerUid == existing().sellerUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().sellerUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'priceUsd', 'originalPriceUsd', 'discountPercent', 'freeShipping', 'stockCount', 'updatedAt'])) ||
                         ((isAdmin() || (isEditor() && hasModerationScope('EDITORIAL_CURATION'))) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isFeatured', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(productId) && (
        existing().sellerUid == request.auth.uid ||
        isAdmin() ||
        (isTeamStaff() && hasModerationScope('MARKETPLACE_SAFETY'))
      );

      match /videoChunks/{chunkId} {
        allow get: if isSignedIn() && isValidId(productId) && isValidId(chunkId);
        allow list: if isSignedIn() && isValidId(productId);
        allow create: if isSignedIn() &&
                         isValidId(productId) &&
                         isValidId(chunkId) &&
                         incoming().keys().hasAll(['index', 'data', 'createdAt']) &&
                         incoming().keys().hasOnly(['index', 'data', 'createdAt']) &&
                         isValidVideoChunk(incoming()) &&
                         exists(/databases/$(database)/documents/marketProducts/$(productId)) &&
                         get(/databases/$(database)/documents/marketProducts/$(productId)).data.sellerUid == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(productId) &&
                         isValidId(chunkId) &&
                         (isAdmin() ||
                          (isTeamStaff() && hasModerationScope('MARKETPLACE_SAFETY')) ||
                          (exists(/databases/$(database)/documents/marketProducts/$(productId)) &&
                           get(/databases/$(database)/documents/marketProducts/$(productId)).data.sellerUid == request.auth.uid));
      }
    }

    // Private Marketplace Orders (visible strictly to buyerUid and sellerUid)
    match /marketOrders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
        request.auth.uid == existing().buyerUid ||
        request.auth.uid == existing().sellerUid
      );
      allow list: if isSignedIn() && (
        request.auth.uid == existing().buyerUid ||
        request.auth.uid == existing().sellerUid
      );

      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       incoming().buyerUid == request.auth.uid &&
                       incoming().sellerUid != request.auth.uid &&
                       incoming().status == 'PLACED' &&
                       incoming().keys().hasAll(['buyerUid', 'buyerUsername', 'sellerUid', 'sellerStoreName', 'productId', 'productTitle', 'productImageKey', 'priceUsd', 'shippingAddress', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['buyerUid', 'buyerUsername', 'sellerUid', 'sellerStoreName', 'productId', 'productTitle', 'productImageKey', 'productImageData', 'priceUsd', 'shippingAddress', 'status', 'createdAt', 'updatedAt']) &&
                       isValidMarketOrder(incoming());

      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       request.auth.uid == existing().sellerUid &&
                       isValidMarketOrder(incoming()) &&
                       incoming().buyerUid == existing().buyerUid &&
                       incoming().sellerUid == existing().sellerUid &&
                       incoming().productId == existing().productId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // Content Moderation & Surveillance Reports (scoped to Admin & enrolled team roles)
    match /contentReports/{reportId} {
      allow get: if isValidId(reportId) && (
        isAdmin() ||
        (isSignedIn() && existing().reporterUid == request.auth.uid) ||
        (isTeamStaff() && hasModerationScope(existing().category))
      );

      allow list: if isAdmin() ||
                     (isSignedIn() && resource.data.reporterUid == request.auth.uid) ||
                     isTeamStaff();

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       (!('reviewedByUid' in incoming()) || incoming().reviewedByUid == null) &&
                       incoming().keys().hasAll(['reporterUid', 'reporterUsername', 'targetType', 'targetId', 'targetAuthorUsername', 'targetPreviewText', 'category', 'reasonDetail', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['reporterUid', 'reporterUsername', 'targetType', 'targetId', 'targetAuthorUid', 'targetAuthorUsername', 'targetPreviewText', 'category', 'reasonDetail', 'status', 'reviewedByUid', 'reviewedByUsername', 'reviewedByRole', 'resolutionNote', 'createdAt', 'updatedAt']) &&
                       isValidContentReport(incoming());

      allow update: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidContentReport(incoming()) &&
                       incoming().reporterUid == existing().reporterUid &&
                       incoming().targetType == existing().targetType &&
                       incoming().targetId == existing().targetId &&
                       incoming().category == existing().category &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedByUsername', 'reviewedByRole', 'resolutionNote', 'updatedAt']) &&
                       incoming().status in ['REMOVED', 'DISMISSED'] &&
                       incoming().reviewedByUid == request.auth.uid &&
                       (
                         (isAdmin() && incoming().reviewedByRole == 'ADMIN') ||
                         ((isModerator() || isEditor()) &&
                          hasModerationScope(existing().category) &&
                          incoming().reviewedByRole == requesterRole())
                       );

      allow delete: if isAdmin() && isValidId(reportId);
    }

    // Momi Account Wallets (strictly owner-private; all balance mutations require atomic CreditTransaction ledger)
    match /wallets/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);

      allow create: if isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'balance', 'totalEarned', 'totalSpent', 'totalPurchased', 'accountTier', 'verificationTier', 'unlockedPerks', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'balance', 'totalEarned', 'totalSpent', 'totalPurchased', 'accountTier', 'verificationTier', 'unlockedPerks', 'lastTxId', 'createdAt', 'updatedAt']) &&
                       isValidUserWallet(incoming(), userId) &&
                       (
                         (isOwner(userId) &&
                          incoming().balance == 0 &&
                          incoming().totalEarned == 0 &&
                          incoming().totalSpent == 0 &&
                          incoming().totalPurchased == 0 &&
                          incoming().accountTier == 'STANDARD' &&
                          incoming().verificationTier == 'NONE' &&
                          incoming().unlockedPerks.size() == 0) ||
                         isValidAdminOwnerWalletCreate(userId)
                       );

      allow update: if isValidId(userId) &&
                       isValidUserWallet(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isOwner(userId) &&
                          (
                            isValidWalletTopUp(userId) ||
                            isValidWalletGiftSend(userId) ||
                            isValidWalletGiftClaim(userId) ||
                            isValidWalletPerkUnlock(userId) ||
                            isValidWalletPostBoost(userId)
                          )) ||
                         isValidAdminOwnerGrant(userId)
                       );

      allow delete: if false;
    }

    // Immutable Credit Ledger (visible only to sender, recipient, or admin)
    match /creditTransactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (
        request.auth.uid == existing().senderUid ||
        request.auth.uid == existing().recipientUid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        request.auth.uid == existing().senderUid ||
        request.auth.uid == existing().recipientUid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(txId) &&
                       incoming().senderUid == request.auth.uid &&
                       incoming().keys().hasAll(['txId', 'type', 'senderUid', 'senderUsername', 'recipientUid', 'recipientUsername', 'creditsAmount', 'priceUsd', 'paymentMethod', 'recipientClaimed', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['txId', 'type', 'senderUid', 'senderUsername', 'recipientUid', 'recipientUsername', 'creditsAmount', 'priceUsd', 'paymentMethod', 'paymentRef', 'giftKey', 'giftName', 'streamId', 'perkKey', 'postId', 'recipientClaimed', 'status', 'createdAt', 'updatedAt']) &&
                       isValidCreditTransaction(incoming(), txId) &&
                       (
                         (existsAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)) &&
                          getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.lastTxId == txId &&
                          (
                            (incoming().type == 'TOP_UP' &&
                             incoming().creditsAmount >= 1 &&
                             incoming().senderUid == incoming().recipientUid &&
                             incoming().recipientClaimed == true &&
                             incoming().creditsAmount in [50, 200, 500, 1200, 3000] &&
                             incoming().paymentMethod in ['GOOGLE_PLAY', 'DEBUG_SANDBOX'] &&
                             ('paymentRef' in incoming()) && incoming().paymentRef is string && incoming().paymentRef.size() >= 6) ||
                            (incoming().type == 'GIFT' &&
                             incoming().creditsAmount >= 1 &&
                             incoming().senderUid != incoming().recipientUid &&
                             incoming().recipientClaimed == false &&
                             incoming().paymentMethod == 'WALLET_CREDITS') ||
                            (incoming().type == 'PERK_UNLOCK' &&
                             incoming().creditsAmount >= 1 &&
                             incoming().senderUid == incoming().recipientUid &&
                             incoming().recipientClaimed == true &&
                             incoming().paymentMethod == 'WALLET_CREDITS' &&
                             incoming().creditsAmount in [100, 250, 500, 1000]) ||
                            (incoming().type == 'POST_BOOST' &&
                             incoming().creditsAmount >= 1 &&
                             incoming().senderUid == incoming().recipientUid &&
                             incoming().recipientClaimed == true &&
                             incoming().paymentMethod == 'WALLET_CREDITS' &&
                             incoming().creditsAmount in [100, 250, 500] &&
                             ('postId' in incoming()) && incoming().postId is string && incoming().postId.size() >= 1)
                          )) ||
                         (isAdmin() &&
                          incoming().type == 'OWNER_GRANT' &&
                          incoming().paymentMethod == 'OWNER_ADMIN' &&
                          incoming().recipientClaimed == true &&
                          existsAfter(/databases/$(database)/documents/wallets/$(incoming().recipientUid)) &&
                          getAfter(/databases/$(database)/documents/wallets/$(incoming().recipientUid)).data.lastTxId == txId)
                       );

      allow update: if isSignedIn() &&
                       isValidId(txId) &&
                       isValidCreditTransaction(incoming(), txId) &&
                       existing().type == 'GIFT' &&
                       existing().recipientUid == request.auth.uid &&
                       existing().recipientClaimed == false &&
                       incoming().recipientClaimed == true &&
                       incoming().senderUid == existing().senderUid &&
                       incoming().recipientUid == existing().recipientUid &&
                       incoming().creditsAmount == existing().creditsAmount &&
                       incoming().type == existing().type &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['recipientClaimed', 'updatedAt']) &&
                       existsAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)) &&
                       getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.lastTxId == txId;

      allow delete: if false;
    }

    // Live Owner App Configuration (Monetizers: AdMob, Start.io, Monetag, Sponsored Partner Banner)
    match /appConfig/{configId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() &&
                               isValidId(configId) &&
                               incoming().keys().hasAll([
                                 'admobEnabled', 'admobBannerUnitId', 'admobMrecUnitId', 'admobInterstitialUnitId',
                                 'startIoEnabled', 'monetagEnabled', 'monetagDirectLinkUrl', 'monetagWebZoneId',
                                 'monetagWebMetaTag', 'partnerPromoTitle', 'partnerPromoSubtitle', 'partnerPromoCta',
                                 'updatedByEmail', 'updatedAt'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'admobEnabled', 'admobBannerUnitId', 'admobMrecUnitId', 'admobInterstitialUnitId',
                                 'startIoEnabled', 'monetagEnabled', 'monetagDirectLinkUrl', 'monetagWebZoneId',
                                 'monetagWebMetaTag', 'partnerPromoTitle', 'partnerPromoSubtitle', 'partnerPromoCta',
                                 'gamezopEnabled', 'gamezopPortalUrl', 'gamezopPublisherId', 'gamezopBannerTitle',
                                 'updatedByEmail', 'updatedAt'
                               ]) &&
                               isValidAppConfig(incoming());
      allow delete: if isAdmin() && isValidId(configId);
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email == 'syali6511@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 50 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 80)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('website' in data) || (data.website is string && data.website.size() <= 200)) &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             (!('avatarData' in data) || data.avatarData == null || (data.avatarData is string && data.avatarData.size() <= 200000)) &&
             data.followersCount is int && data.followersCount >= 0 &&
             data.followingCount is int && data.followingCount >= 0 &&
             data.isVerified is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidPost(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 50 &&
             data.authorDisplayName is string && data.authorDisplayName.size() >= 1 && data.authorDisplayName.size() <= 80 &&
             data.authorAvatarKey is string && data.authorAvatarKey.size() >= 1 && data.authorAvatarKey.size() <= 64 &&
             data.authorVerified is bool &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 64 &&
             (!('localImagePath' in data) || data.localImagePath == null || (data.localImagePath is string && data.localImagePath.size() <= 500)) &&
             (!('imageData' in data) || data.imageData == null || (data.imageData is string && data.imageData.size() <= 700000)) &&
             (!('localExtraImagePaths' in data) || data.localExtraImagePaths == null || (data.localExtraImagePaths is list && data.localExtraImagePaths.size() <= 4)) &&
             (!('extraImageDatas' in data) || data.extraImageDatas == null || (data.extraImageDatas is list && data.extraImageDatas.size() <= 4)) &&
             (!('mediaType' in data) || data.mediaType == null || (data.mediaType is string && data.mediaType in ['IMAGE', 'VIDEO'])) &&
             (!('localVideoPath' in data) || data.localVideoPath == null || (data.localVideoPath is string && data.localVideoPath.size() <= 500)) &&
             (!('videoData' in data) || data.videoData == null || (data.videoData is string && data.videoData.size() <= 700000)) &&
             (!('videoChunksCount' in data) || data.videoChunksCount == null || (data.videoChunksCount is int && data.videoChunksCount >= 0 && data.videoChunksCount <= 25)) &&
             (!('videoDurationMs' in data) || data.videoDurationMs == null || (data.videoDurationMs is int && data.videoDurationMs >= 0 && data.videoDurationMs <= 3600000)) &&
             data.filterTag is string && data.filterTag in ['NONE', 'BLUE', 'MAROON', 'MONO'] &&
             data.caption is string && data.caption.size() <= 1000 &&
             data.likesCount is int && data.likesCount >= 0 &&
             (!('viewsCount' in data) || data.viewsCount == null || (data.viewsCount is int && data.viewsCount >= 0)) &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.isReel is bool &&
             (!('audioTitle' in data) || (data.audioTitle is string && data.audioTitle.size() <= 120)) &&
             (!('localAudioPath' in data) || data.localAudioPath == null || (data.localAudioPath is string && data.localAudioPath.size() <= 500)) &&
             (!('audioData' in data) || data.audioData == null || (data.audioData is string && data.audioData.size() <= 660000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidComment(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 50 &&
             data.authorAvatarKey is string && data.authorAvatarKey.size() >= 1 && data.authorAvatarKey.size() <= 64 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidStory(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 50 &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 64 &&
             (!('localImagePath' in data) || data.localImagePath == null || (data.localImagePath is string && data.localImagePath.size() <= 500)) &&
             (!('imageData' in data) || data.imageData == null || (data.imageData is string && data.imageData.size() <= 700000)) &&
             (!('mediaType' in data) || data.mediaType == null || (data.mediaType is string && data.mediaType in ['IMAGE', 'VIDEO'])) &&
             (!('localVideoPath' in data) || data.localVideoPath == null || (data.localVideoPath is string && data.localVideoPath.size() <= 500)) &&
             (!('videoData' in data) || data.videoData == null || (data.videoData is string && data.videoData.size() <= 700000)) &&
             (!('videoChunksCount' in data) || data.videoChunksCount == null || (data.videoChunksCount is int && data.videoChunksCount >= 0 && data.videoChunksCount <= 25)) &&
             (!('videoDurationMs' in data) || data.videoDurationMs == null || (data.videoDurationMs is int && data.videoDurationMs >= 0 && data.videoDurationMs <= 3600000)) &&
             (!('audioTitle' in data) || data.audioTitle == null || (data.audioTitle is string && data.audioTitle.size() <= 120)) &&
             (!('localAudioPath' in data) || data.localAudioPath == null || (data.localAudioPath is string && data.localAudioPath.size() <= 500)) &&
             (!('audioData' in data) || data.audioData == null || (data.audioData is string && data.audioData.size() <= 660000)) &&
             data.caption is string && data.caption.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidVideoChunk(data) {
      return data.index is int &&
             data.index >= 0 &&
             data.index < 25 &&
             data.data is string &&
             data.data.size() >= 1 &&
             data.data.size() <= 700000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidFollow(data, followId) {
      return data.followerUid is string && isValidId(data.followerUid) &&
             data.targetUid is string && isValidId(data.targetUid) &&
             data.followerUid != data.targetUid &&
             followId == data.followerUid + '_' + data.targetUid &&
             data.followerUsername is string && data.followerUsername.size() >= 1 && data.followerUsername.size() <= 50 &&
             data.targetUsername is string && data.targetUsername.size() >= 1 && data.targetUsername.size() <= 50 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidInteractionMarker(data, targetId) {
      return data.targetId is string && data.targetId == targetId &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidNotification(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.actorUid is string && isValidId(data.actorUid) &&
             data.actorUsername is string && data.actorUsername.size() >= 1 && data.actorUsername.size() <= 50 &&
             data.actorAvatarKey is string && data.actorAvatarKey.size() >= 1 && data.actorAvatarKey.size() <= 64 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 300 &&
             data.timeLabel is string && data.timeLabel.size() >= 1 && data.timeLabel.size() <= 30 &&
             data.section is string && data.section.size() >= 1 && data.section.size() <= 30 &&
             (!('previewImageKey' in data) || data.previewImageKey == null || (data.previewImageKey is string && data.previewImageKey.size() <= 64)) &&
             data.isFollowAction is bool &&
             data.isFollowingBack is bool &&
             data.isUnread is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMessageThread(data) {
      return data.participantUids is list &&
             data.participantUids.size() == 2 &&
             data.participantUids[0] is string && isValidId(data.participantUids[0]) &&
             data.participantUids[1] is string && isValidId(data.participantUids[1]) &&
             data.participantUids[0] != data.participantUids[1] &&
             data.userAId is string && data.userAId == data.participantUids[0] &&
             data.userBId is string && data.userBId == data.participantUids[1] &&
             data.userAUsername is string && data.userAUsername.size() >= 1 && data.userAUsername.size() <= 50 &&
             data.userADisplayName is string && data.userADisplayName.size() >= 1 && data.userADisplayName.size() <= 80 &&
             data.userAAvatarKey is string && data.userAAvatarKey.size() >= 1 && data.userAAvatarKey.size() <= 64 &&
             data.userBUsername is string && data.userBUsername.size() >= 1 && data.userBUsername.size() <= 50 &&
             data.userBDisplayName is string && data.userBDisplayName.size() >= 1 && data.userBDisplayName.size() <= 80 &&
             data.userBAvatarKey is string && data.userBAvatarKey.size() >= 1 && data.userBAvatarKey.size() <= 64 &&
             data.lastMessage is string && data.lastMessage.size() <= 500 &&
             data.lastSenderUid is string && data.lastSenderUid.size() <= 128 &&
             data.unreadUid is string && data.unreadUid.size() <= 128 &&
             data.timeLabel is string && data.timeLabel.size() >= 1 && data.timeLabel.size() <= 30 &&
             data.unreadCount is int && data.unreadCount >= 0 &&
             data.isOnline is bool &&
             (!('noteText' in data) || data.noteText == null || (data.noteText is string && data.noteText.size() <= 100)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatMessage(data) {
      return data.participantUids is list &&
             data.participantUids.size() == 2 &&
             data.participantUids[0] is string &&
             data.participantUids[1] is string &&
             data.senderUid is string && isValidId(data.senderUid) &&
             data.senderUid in data.participantUids &&
             data.senderUsername is string && data.senderUsername.size() >= 1 && data.senderUsername.size() <= 50 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             (!('messageType' in data) || (data.messageType is string && data.messageType in ['TEXT', 'IMAGE', 'VIDEO', 'AUDIO'])) &&
             (!('imageData' in data) || data.imageData == null || (data.imageData is string && data.imageData.size() <= 700000)) &&
             (!('videoData' in data) || data.videoData == null || (data.videoData is string && data.videoData.size() <= 700000)) &&
             (!('videoDurationMs' in data) || data.videoDurationMs == null || (data.videoDurationMs is int && data.videoDurationMs >= 0 && data.videoDurationMs <= 3600000)) &&
             (!('audioData' in data) || data.audioData == null || (data.audioData is string && data.audioData.size() <= 660000)) &&
             (!('audioDurationMs' in data) || data.audioDurationMs == null || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 600000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLiveStream(data, streamId) {
      return data.userId is string && data.userId == streamId && isValidId(data.userId) &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 50 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             data.authorVerified is bool &&
             data.title is string && data.title.size() <= 140 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.isLive is bool &&
             data.viewerCount is int && data.viewerCount >= 0 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidLiveComment(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 50 &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidMerchant(data, merchantId) {
      return data.userId is string && data.userId == merchantId && isValidId(data.userId) &&
             data.ownerUsername is string && data.ownerUsername.size() >= 1 && data.ownerUsername.size() <= 50 &&
             data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
             data.tagline is string && data.tagline.size() <= 160 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.location is string && data.location.size() <= 120 &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             (!('avatarData' in data) || data.avatarData == null || (data.avatarData is string && data.avatarData.size() <= 200000)) &&
             data.isVerified is bool &&
             (!('verifiedByEmail' in data) || data.verifiedByEmail == null || (data.verifiedByEmail is string && data.verifiedByEmail.size() <= 120)) &&
             data.totalSales is int && data.totalSales >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMarketProduct(data) {
      return data.sellerUid is string && isValidId(data.sellerUid) &&
             data.sellerUsername is string && data.sellerUsername.size() >= 1 && data.sellerUsername.size() <= 50 &&
             data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 1000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             (data.priceUsd is int || data.priceUsd is float) && data.priceUsd > 0 &&
             (data.originalPriceUsd is int || data.originalPriceUsd is float) && data.originalPriceUsd >= 0 &&
             data.discountPercent is int && data.discountPercent >= 0 && data.discountPercent <= 95 &&
             data.freeShipping is bool &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 64 &&
             (!('imageData' in data) || data.imageData == null || (data.imageData is string && data.imageData.size() <= 700000)) &&
             (!('extraImageDatas' in data) || data.extraImageDatas == null || (data.extraImageDatas is list && data.extraImageDatas.size() <= 4)) &&
             (!('videoData' in data) || data.videoData == null || (data.videoData is string && data.videoData.size() <= 700000)) &&
             (!('videoChunksCount' in data) || data.videoChunksCount == null || (data.videoChunksCount is int && data.videoChunksCount >= 0 && data.videoChunksCount <= 25)) &&
             data.videoDurationMs is int && data.videoDurationMs >= 0 && data.videoDurationMs <= 3600000 &&
             data.stockCount is int && data.stockCount >= 0 && data.stockCount <= 99999 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMarketOrder(data) {
      return data.buyerUid is string && isValidId(data.buyerUid) &&
             data.buyerUsername is string && data.buyerUsername.size() >= 1 && data.buyerUsername.size() <= 50 &&
             data.sellerUid is string && isValidId(data.sellerUid) &&
             data.buyerUid != data.sellerUid &&
             data.sellerStoreName is string && data.sellerStoreName.size() >= 1 && data.sellerStoreName.size() <= 80 &&
             data.productId is string && isValidId(data.productId) &&
             data.productTitle is string && data.productTitle.size() >= 1 && data.productTitle.size() <= 120 &&
             data.productImageKey is string && data.productImageKey.size() >= 1 && data.productImageKey.size() <= 64 &&
             (!('productImageData' in data) || data.productImageData == null || (data.productImageData is string && data.productImageData.size() <= 700000)) &&
             (data.priceUsd is int || data.priceUsd is float) && data.priceUsd > 0 &&
             data.shippingAddress is string && data.shippingAddress.size() >= 1 && data.shippingAddress.size() <= 300 &&
             data.status is string && data.status in ['PLACED', 'SHIPPED', 'DELIVERED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Public creator profiles (strictly no PII) + owner-isolated private subcollections
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'username', 'displayName', 'avatarKey', 'followersCount', 'followingCount', 'isVerified', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'displayName', 'category', 'bio', 'website', 'avatarKey', 'avatarData', 'followersCount', 'followingCount', 'isVerified', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId) &&
                       (incoming().isVerified == false || isAdmin());

      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isOwner(userId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'category', 'bio', 'website', 'avatarKey', 'avatarData', 'updatedAt'])) ||
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'updatedAt']))
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /likedPosts/{postId} {
        allow get: if isOwner(userId) && isValidId(postId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(postId) &&
                         incoming().keys().hasAll(['targetId', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetId', 'createdAt']) &&
                         isValidInteractionMarker(incoming(), postId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(postId);
      }

      match /bookmarks/{postId} {
        allow get: if isOwner(userId) && isValidId(postId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(postId) &&
                         incoming().keys().hasAll(['targetId', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetId', 'createdAt']) &&
                         isValidInteractionMarker(incoming(), postId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(postId);
      }

      match /seenStories/{storyId} {
        allow get: if isOwner(userId) && isValidId(storyId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(storyId) &&
                         incoming().keys().hasAll(['targetId', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetId', 'createdAt']) &&
                         isValidInteractionMarker(incoming(), storyId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(storyId);
      }

      match /likedComments/{commentId} {
        allow get: if isOwner(userId) && isValidId(commentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(commentId) &&
                         incoming().keys().hasAll(['targetId', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetId', 'createdAt']) &&
                         isValidInteractionMarker(incoming(), commentId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(commentId);
      }

      match /notifications/{notificationId} {
        allow get: if isOwner(userId) && isValidId(notificationId);
        allow list: if isOwner(userId);

        // Recipient can only see their own notifications; any signed-in actor can send a notification to userId
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(notificationId) &&
                         incoming().actorUid == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'actorUid', 'actorUsername', 'actorAvatarKey', 'message', 'timeLabel', 'section', 'isFollowAction', 'isFollowingBack', 'isUnread', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'actorUid', 'actorUsername', 'actorAvatarKey', 'message', 'timeLabel', 'section', 'previewImageKey', 'isFollowAction', 'isFollowingBack', 'isUnread', 'createdAt', 'updatedAt']) &&
                         isValidNotification(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(notificationId) &&
                         isValidNotification(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().actorUid == existing().actorUid &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['isFollowingBack', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['isUnread', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(notificationId);
      }
    }

    // Global Shared Feed Posts & Clips
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'authorUsername', 'authorDisplayName', 'authorAvatarKey', 'authorVerified', 'imageKey', 'filterTag', 'caption', 'likesCount', 'commentsCount', 'category', 'isReel', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorUsername', 'authorDisplayName', 'authorAvatarKey', 'authorVerified', 'location', 'imageKey', 'localImagePath', 'imageData', 'localExtraImagePaths', 'extraImageDatas', 'mediaType', 'localVideoPath', 'videoData', 'videoChunksCount', 'videoDurationMs', 'localAudioPath', 'audioData', 'filterTag', 'caption', 'likesCount', 'viewsCount', 'commentsCount', 'category', 'isReel', 'audioTitle', 'createdAt', 'updatedAt']) &&
                       isValidPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidPost(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'location', 'updatedAt'])) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                           (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1)) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt']) &&
                           ((('viewsCount' in existing()) && existing().viewsCount is int && incoming().viewsCount == existing().viewsCount + 1) ||
                            (!('viewsCount' in existing()) && incoming().viewsCount == 1))) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) &&
                           (incoming().commentsCount == existing().commentsCount + 1 || incoming().commentsCount == existing().commentsCount - 1))
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().userId == request.auth.uid;

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(postId);

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'authorUsername', 'authorAvatarKey', 'text', 'likesCount', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'authorUsername', 'authorAvatarKey', 'text', 'likesCount', 'createdAt', 'updatedAt']) &&
                         isValidComment(incoming()) &&
                         exists(/databases/$(database)/documents/posts/$(postId));

        allow update: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         isValidComment(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                         (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1);

        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         (existing().userId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }

      match /videoChunks/{chunkId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(chunkId);
        allow list: if isSignedIn() && isValidId(postId);
        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(chunkId) &&
                         incoming().keys().hasAll(['index', 'data', 'createdAt']) &&
                         incoming().keys().hasOnly(['index', 'data', 'createdAt']) &&
                         isValidVideoChunk(incoming()) &&
                         exists(/databases/$(database)/documents/posts/$(postId)) &&
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(chunkId) &&
                         exists(/databases/$(database)/documents/posts/$(postId)) &&
                         get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid;
      }
    }

    // Global Shared Stories
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'avatarKey', 'imageKey', 'caption', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'avatarKey', 'imageKey', 'localImagePath', 'imageData', 'mediaType', 'localVideoPath', 'videoData', 'videoChunksCount', 'videoDurationMs', 'audioTitle', 'localAudioPath', 'audioData', 'caption', 'createdAt', 'updatedAt']) &&
                       isValidStory(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(storyId) && existing().userId == request.auth.uid;

      match /videoChunks/{chunkId} {
        allow get: if isSignedIn() && isValidId(storyId) && isValidId(chunkId);
        allow list: if isSignedIn() && isValidId(storyId);
        allow create: if isSignedIn() &&
                         isValidId(storyId) &&
                         isValidId(chunkId) &&
                         incoming().keys().hasAll(['index', 'data', 'createdAt']) &&
                         incoming().keys().hasOnly(['index', 'data', 'createdAt']) &&
                         isValidVideoChunk(incoming()) &&
                         exists(/databases/$(database)/documents/stories/$(storyId)) &&
                         get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(storyId) &&
                         isValidId(chunkId) &&
                         exists(/databases/$(database)/documents/stories/$(storyId)) &&
                         get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }
    }

    // Shared Follow Graph
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(followId) &&
                       incoming().followerUid == request.auth.uid &&
                       incoming().keys().hasAll(['followerUid', 'targetUid', 'followerUsername', 'targetUsername', 'createdAt']) &&
                       incoming().keys().hasOnly(['followerUid', 'targetUid', 'followerUsername', 'targetUsername', 'createdAt']) &&
                       isValidFollow(incoming(), followId);

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(followId) && existing().followerUid == request.auth.uid;
    }

    // Shared 1:1 Direct Message Threads (strictly participant-only)
    match /threads/{threadId} {
      allow get: if isSignedIn() && isValidId(threadId) && (
        (resource == null && (
          (threadId.size() > request.auth.uid.size() + 1 && threadId[0 : request.auth.uid.size() + 1] == request.auth.uid + '_') ||
          (threadId.size() > request.auth.uid.size() + 1 && threadId[threadId.size() - request.auth.uid.size() - 1 : threadId.size()] == '_' + request.auth.uid)
        )) ||
        (resource != null && request.auth.uid in existing().participantUids)
      );
      allow list: if isSignedIn() && request.auth.uid in existing().participantUids;

      allow create: if isSignedIn() &&
                       isValidId(threadId) &&
                       incoming().keys().hasAll(['participantUids', 'userAId', 'userAUsername', 'userADisplayName', 'userAAvatarKey', 'userBId', 'userBUsername', 'userBDisplayName', 'userBAvatarKey', 'lastMessage', 'lastSenderUid', 'unreadUid', 'timeLabel', 'unreadCount', 'isOnline', 'createdAt']) &&
                       incoming().keys().hasOnly(['participantUids', 'userAId', 'userAUsername', 'userADisplayName', 'userAAvatarKey', 'userBId', 'userBUsername', 'userBDisplayName', 'userBAvatarKey', 'lastMessage', 'lastSenderUid', 'unreadUid', 'timeLabel', 'unreadCount', 'isOnline', 'noteText', 'createdAt', 'updatedAt']) &&
                       isValidMessageThread(incoming()) &&
                       request.auth.uid in incoming().participantUids &&
                       threadId == incoming().userAId + '_' + incoming().userBId;

      allow update: if isSignedIn() &&
                       isValidId(threadId) &&
                       request.auth.uid in existing().participantUids &&
                       isValidMessageThread(incoming()) &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().userAId == existing().userAId &&
                       incoming().userBId == existing().userBId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['unreadUid', 'unreadCount', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'timeLabel', 'unreadUid', 'unreadCount', 'updatedAt'])
                       );

      allow delete: if isSignedIn() && isValidId(threadId) && request.auth.uid in existing().participantUids;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(threadId) && isValidId(messageId) && request.auth.uid in existing().participantUids;
        allow list: if isSignedIn() && isValidId(threadId) && request.auth.uid in existing().participantUids;

        allow create: if isSignedIn() &&
                         isValidId(threadId) &&
                         isValidId(messageId) &&
                         incoming().senderUid == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         incoming().keys().hasAll(['participantUids', 'senderUid', 'senderUsername', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['participantUids', 'senderUid', 'senderUsername', 'text', 'messageType', 'imageData', 'videoData', 'videoDurationMs', 'audioData', 'audioDurationMs', 'createdAt']) &&
                         isValidChatMessage(incoming()) &&
                         exists(/databases/$(database)/documents/threads/$(threadId)) &&
                         incoming().participantUids == get(/databases/$(database)/documents/threads/$(threadId)).data.participantUids;

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(threadId) && isValidId(messageId) && existing().senderUid == request.auth.uid;
      }
    }

    // Shared Momi Live Broadcast Rooms & Live Chat
    match /liveStreams/{streamId} {
      allow get: if isSignedIn() && isValidId(streamId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(streamId) &&
                       streamId == request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'displayName', 'avatarKey', 'authorVerified', 'title', 'category', 'isLive', 'viewerCount', 'likesCount', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'displayName', 'avatarKey', 'authorVerified', 'title', 'category', 'isLive', 'viewerCount', 'likesCount', 'createdAt', 'updatedAt']) &&
                       isValidLiveStream(incoming(), streamId);

      allow update: if isSignedIn() &&
                       isValidId(streamId) &&
                       isValidLiveStream(incoming(), streamId) &&
                       incoming().userId == existing().userId &&
                       (
                         (existing().userId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'avatarKey', 'authorVerified', 'title', 'category', 'isLive', 'viewerCount', 'likesCount', 'createdAt', 'updatedAt'])) ||
                         (incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['viewerCount', 'updatedAt']) &&
                           (incoming().viewerCount == existing().viewerCount + 1 || incoming().viewerCount == existing().viewerCount - 1)) ||
                         (incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
                           incoming().likesCount == existing().likesCount + 1)
                       );

      allow delete: if isSignedIn() && isValidId(streamId) && existing().userId == request.auth.uid;

      match /liveComments/{commentId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(streamId);

        allow create: if isSignedIn() &&
                         isValidId(streamId) &&
                         isValidId(commentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'username', 'avatarKey', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'username', 'avatarKey', 'text', 'createdAt']) &&
                         isValidLiveComment(incoming()) &&
                         exists(/databases/$(database)/documents/liveStreams/$(streamId));

        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(streamId) &&
                         isValidId(commentId) &&
                         (existing().userId == request.auth.uid || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.userId == request.auth.uid);
      }
    }

    // Momi Marketplace Merchants (admin-only verification)
    match /merchants/{merchantId} {
      allow get: if isSignedIn() && isValidId(merchantId);
      allow list: if isSignedIn();

      allow create: if isOwner(merchantId) &&
                       isValidId(merchantId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'ownerUsername', 'storeName', 'tagline', 'category', 'location', 'avatarKey', 'isVerified', 'totalSales', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'ownerUsername', 'storeName', 'tagline', 'category', 'location', 'avatarKey', 'avatarData', 'isVerified', 'verifiedByEmail', 'totalSales', 'createdAt', 'updatedAt']) &&
                       isValidMerchant(incoming(), merchantId) &&
                       incoming().isVerified == false &&
                       incoming().totalSales == 0;

      allow update: if isSignedIn() &&
                       isValidId(merchantId) &&
                       isValidMerchant(incoming(), merchantId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isOwner(merchantId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['storeName', 'tagline', 'category', 'location', 'avatarData', 'updatedAt'])) ||
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verifiedByEmail', 'updatedAt']))
                       );

      allow delete: if isOwner(merchantId) && isValidId(merchantId);
    }

    // Momi Marketplace Products & Chunked Product Videos
    match /marketProducts/{productId} {
      allow get: if isSignedIn() && isValidId(productId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(productId) &&
                       incoming().sellerUid == request.auth.uid &&
                       incoming().keys().hasAll(['sellerUid', 'sellerUsername', 'storeName', 'title', 'description', 'category', 'priceUsd', 'originalPriceUsd', 'discountPercent', 'freeShipping', 'imageKey', 'videoDurationMs', 'stockCount', 'createdAt']) &&
                       incoming().keys().hasOnly(['sellerUid', 'sellerUsername', 'storeName', 'title', 'description', 'category', 'priceUsd', 'originalPriceUsd', 'discountPercent', 'freeShipping', 'imageKey', 'imageData', 'extraImageDatas', 'videoData', 'videoChunksCount', 'videoDurationMs', 'stockCount', 'createdAt', 'updatedAt']) &&
                       isValidMarketProduct(incoming());

      allow update: if isSignedIn() &&
                       isValidId(productId) &&
                       existing().sellerUid == request.auth.uid &&
                       isValidMarketProduct(incoming()) &&
                       incoming().sellerUid == existing().sellerUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'priceUsd', 'originalPriceUsd', 'discountPercent', 'freeShipping', 'stockCount', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(productId) && existing().sellerUid == request.auth.uid;

      match /videoChunks/{chunkId} {
        allow get: if isSignedIn() && isValidId(productId) && isValidId(chunkId);
        allow list: if isSignedIn() && isValidId(productId);
        allow create: if isSignedIn() &&
                         isValidId(productId) &&
                         isValidId(chunkId) &&
                         incoming().keys().hasAll(['index', 'data', 'createdAt']) &&
                         incoming().keys().hasOnly(['index', 'data', 'createdAt']) &&
                         isValidVideoChunk(incoming()) &&
                         exists(/databases/$(database)/documents/marketProducts/$(productId)) &&
                         get(/databases/$(database)/documents/marketProducts/$(productId)).data.sellerUid == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(productId) &&
                         isValidId(chunkId) &&
                         exists(/databases/$(database)/documents/marketProducts/$(productId)) &&
                         get(/databases/$(database)/documents/marketProducts/$(productId)).data.sellerUid == request.auth.uid;
      }
    }

    // Private Marketplace Orders (visible strictly to buyerUid and sellerUid)
    match /marketOrders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
        request.auth.uid == existing().buyerUid ||
        request.auth.uid == existing().sellerUid
      );
      allow list: if isSignedIn() && (
        request.auth.uid == existing().buyerUid ||
        request.auth.uid == existing().sellerUid
      );

      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       incoming().buyerUid == request.auth.uid &&
                       incoming().sellerUid != request.auth.uid &&
                       incoming().status == 'PLACED' &&
                       incoming().keys().hasAll(['buyerUid', 'buyerUsername', 'sellerUid', 'sellerStoreName', 'productId', 'productTitle', 'productImageKey', 'priceUsd', 'shippingAddress', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['buyerUid', 'buyerUsername', 'sellerUid', 'sellerStoreName', 'productId', 'productTitle', 'productImageKey', 'productImageData', 'priceUsd', 'shippingAddress', 'status', 'createdAt', 'updatedAt']) &&
                       isValidMarketOrder(incoming());

      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       request.auth.uid == existing().sellerUid &&
                       isValidMarketOrder(incoming()) &&
                       incoming().buyerUid == existing().buyerUid &&
                       incoming().sellerUid == existing().sellerUid &&
                       incoming().productId == existing().productId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }
  }
}
